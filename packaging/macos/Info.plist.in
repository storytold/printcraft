<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/macos/package.sh substitutes @VERSION@ (full, e.g. 0.2.0-rc.1),
     @SHORT_VERSION@ (numeric X.Y.Z) and @BUILD_SHA@. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>PdfCraft</string>
  <key>CFBundleName</key>
  <string>PdfCraft</string>
  <key>CFBundleExecutable</key>
  <string>PdfCraft</string>
  <key>CFBundleIdentifier</key>
  <string>ai.storyteller.pdfcraft</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>PdfCraftVersion</key>
  <string>@VERSION@</string>
  <key>PdfCraftBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>PdfCraft</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.graphics-design</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. Big Sur is the first release on
       Apple silicon and has the Metal feature set wgpu targets. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © the PdfCraft authors. MIT OR Apache-2.0.</string>

  <!-- Documents PdfCraft opens (#73): it is offered under Open With and can be made the default
       for PDFs, without taking over from the system's viewer on install ("Alternate"). Declared by
       UTI (LSItemContentTypes, what modern macOS filters Open With > Recommended Applications on),
       plus extension and MIME type for backward compatibility. Finder hands the
       file over as an Apple event, which apps/pdfcraft/src/apple_events.rs receives. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>PDF Document</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>CFBundleTypeIconFile</key>
      <string>PdfCraft</string>
      <key>LSItemContentTypes</key>
      <array><string>com.adobe.pdf</string></array>
      <key>CFBundleTypeExtensions</key>
      <array><string>pdf</string></array>
      <key>CFBundleTypeMIMETypes</key>
      <array><string>application/pdf</string></array>
    </dict>
  </array>

</dict>
</plist>
